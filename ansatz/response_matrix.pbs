#!/bin/bash
#PBS -j oe
#PBS -V
#PBS -r n
set -euo pipefail
ulimit -s unlimited
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
cd /home2/25_li/CrI3
if [[ "$RESPONSE_ACTION" == endpoint ]]; then
    python3 -u ansatz/response_matrix.py endpoint "$RESPONSE_INDEX"
else
    python3 -u ansatz/response_matrix.py "$RESPONSE_ACTION"
fi
