#!/bin/bash
#PBS -j oe
#PBS -V
#PBS -r n
set -euo pipefail
ulimit -s unlimited
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
if [[ "$S13_ACTION" == endpoint ]]; then
    "${PYTHON:-python3}" -u 7_spin/torque_s13.py endpoint "$S13_SIDE"
else
    "${PYTHON:-python3}" -u 7_spin/torque_s13.py "$S13_ACTION"
fi
